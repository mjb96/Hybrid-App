{
  "name": "hybrid-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "precache:gen": "node scripts/gen-precache.mjs",
    "precache:check": "node scripts/gen-precache.mjs --check",
    "verify": "npm run typecheck && npm run precache:check && npm test && npm run smoke"
  },
  "devDependencies": {
    "@sentry/browser": "8.55.0",
    "@supabase/supabase-js": "2.45.4",
    "leaflet": "1.9.4",
    "typescript": "^6.0.3"
  }
}
